# Copy to .env for a new checkout; keep existing credentials when editing.
# The public Evidence8 website is not an API base. This is the documented local API.
EVIDENCE8_BASE_URL=http://127.0.0.1:8787
# Optional: only set when your Evidence8 workspace requires a bearer key.
EVIDENCE8_API_KEY=
# Required for the corresponding live provider (Keenable keyless mode is opt-in).
KEENABLE_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
