{
  "$defs": {
    "Attestation": {
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "default": "unknown",
          "enum": [
            "indexed",
            "known_unindexed",
            "external_holdout",
            "unknown"
          ],
          "title": "Bucket",
          "type": "string"
        },
        "evidence_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Reference"
        },
        "frozen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frozen At"
        },
        "index_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Version"
        },
        "provider": {
          "default": "evidence8",
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "Attestation",
      "type": "object"
    },
    "FetchLimits": {
      "additionalProperties": false,
      "properties": {
        "max_assets": {
          "default": 200,
          "minimum": 1,
          "title": "Max Assets",
          "type": "integer"
        },
        "max_bytes": {
          "default": 20971520,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_documents": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Documents",
          "type": "integer"
        },
        "max_pages": {
          "default": 200,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "max_text_chars": {
          "default": 100000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Text Chars",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "FetchLimits",
      "type": "object"
    },
    "Protocol": {
      "enum": [
        "search",
        "search_fetch",
        "evidence"
      ],
      "title": "Protocol",
      "type": "string"
    },
    "ProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "corpus": {
          "default": "all",
          "title": "Corpus",
          "type": "string"
        },
        "country": {
          "default": "us",
          "title": "Country",
          "type": "string"
        },
        "keyless": {
          "default": false,
          "title": "Keyless",
          "type": "boolean"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "name": {
          "enum": [
            "evidence8",
            "keenable",
            "exa",
            "serper",
            "keenable_evidence8"
          ],
          "title": "Name",
          "type": "string"
        },
        "request_cost_ceiling_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Cost Ceiling Usd"
        }
      },
      "required": [
        "name"
      ],
      "title": "ProviderConfig",
      "type": "object"
    },
    "RunConfig": {
      "additionalProperties": false,
      "properties": {
        "benchmark_version": {
          "default": "development-v0.1",
          "title": "Benchmark Version",
          "type": "string"
        },
        "fetch": {
          "$ref": "#/$defs/FetchLimits"
        },
        "k": {
          "default": 10,
          "maximum": 10,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "max_cost_usd": {
          "default": 0,
          "minimum": 0,
          "title": "Max Cost Usd",
          "type": "number"
        },
        "max_requests": {
          "default": 1000,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol",
          "default": "evidence"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/ProviderConfig"
          },
          "minItems": 1,
          "title": "Providers",
          "type": "array"
        },
        "seed": {
          "default": 17,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "providers"
      ],
      "title": "RunConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "code_artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Artifact Sha256"
    },
    "code_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Code Sha256",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "config": {
      "$ref": "#/$defs/RunConfig"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "dataset_release_ready": {
      "default": false,
      "title": "Dataset Release Ready",
      "type": "boolean"
    },
    "dataset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Sha256",
      "type": "string"
    },
    "dependency_lock_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dependency Lock Sha256"
    },
    "freeze_attestations": {
      "items": {
        "$ref": "#/$defs/Attestation"
      },
      "title": "Freeze Attestations",
      "type": "array"
    },
    "mode": {
      "enum": [
        "live",
        "replay"
      ],
      "title": "Mode",
      "type": "string"
    },
    "publication_eligible": {
      "default": false,
      "title": "Publication Eligible",
      "type": "boolean"
    },
    "requests": {
      "default": 0,
      "title": "Requests",
      "type": "integer"
    },
    "reserved_cost_usd": {
      "default": 0,
      "title": "Reserved Cost Usd",
      "type": "number"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "vessel.run.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "default": "running",
      "enum": [
        "running",
        "complete",
        "incomplete"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "benchmark_version",
    "dataset_sha256",
    "config_sha256",
    "code_sha256",
    "started_at",
    "config",
    "mode"
  ],
  "title": "RunManifest",
  "type": "object"
}
