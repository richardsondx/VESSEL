          "type": "null"
        }
      ],
      "default": null,
      "title": "Reproducibility Url"
    },
    "rights": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rights"
